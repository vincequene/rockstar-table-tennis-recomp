+// Real Xbox 360 sockets are small positive integers; titles commonly test
+// "socket >= 0" with a signed compare. Kernel object handles (0xF8xxxxxx) are
+// negative as int32, so expose a small positive alias to the guest instead.
+constexpr uint32_t kGuestSocketBias = 0x100;
+inline uint32_t HostToGuestSocket(uint32_t handle) {
+  return handle - XObject::kHandleBase + kGuestSocketBias;
+}
+inline uint32_t GuestToHostSocket(uint32_t guest) {
+  if (guest >= kGuestSocketBias && guest < 0x01000000) {
+    return guest - kGuestSocketBias + XObject::kHandleBase;
+  }
+  return guest;
+}
