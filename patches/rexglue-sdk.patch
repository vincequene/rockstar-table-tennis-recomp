--- /dev/null
+++ b/include/rex/system/presence.h
@@ -0,0 +1,31 @@
+/**
+ * @file        rex/system/presence.h
+ * @brief       Hook point for title rich presence (XUserSetContext/Property).
+ *
+ * The XGI app forwards every context/property the title sets so a host app can
+ * mirror the original Xbox Live presence (e.g. to Discord Rich Presence).
+ */
+#pragma once
+
+#include <cstdint>
+#include <functional>
+
+namespace rex::system::presence {
+
+enum class Kind { kContext, kProperty };
+
+using Listener = std::function<void(uint32_t user_index, Kind kind, uint32_t id, int64_t value)>;
+
+// Replaces the current listener (pass nullptr to clear). Thread-safe.
+void SetListener(Listener listener);
+
+// Called by the kernel when the title updates a context or property.
+void Notify(uint32_t user_index, Kind kind, uint32_t id, int64_t value);
+
+// Host handler for the dashboard achievements UI (XamShowAchievementsUI).
+// Returns true if the host showed its own achievements screen.
+using AchievementsUiHandler = std::function<bool(uint32_t user_index)>;
+void SetAchievementsUiHandler(AchievementsUiHandler handler);
+bool ShowAchievementsUi(uint32_t user_index);
+
+}  // namespace rex::system::presence
