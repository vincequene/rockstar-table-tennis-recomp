@@ -0,0 +1,60 @@
+/**
+ * @file        system/presence.cpp
+ * @brief       Rich presence listener registry.
+ */
+#include <rex/system/presence.h>
+
+#include <mutex>
+#include <utility>
+
+namespace rex::system::presence {
+
+namespace {
+std::mutex& ListenerMutex() {
+  static std::mutex m;
+  return m;
+}
+Listener& ListenerStorage() {
+  static Listener l;
+  return l;
+}
+}  // namespace
+
+void SetListener(Listener listener) {
+  std::lock_guard lock(ListenerMutex());
+  ListenerStorage() = std::move(listener);
+}
+
+void Notify(uint32_t user_index, Kind kind, uint32_t id, int64_t value) {
+  Listener copy;
+  {
+    std::lock_guard lock(ListenerMutex());
+    copy = ListenerStorage();
+  }
+  if (copy) {
+    copy(user_index, kind, id, value);
+  }
+}
+
+namespace {
+AchievementsUiHandler& UiHandlerStorage() {
+  static AchievementsUiHandler h;
+  return h;
+}
+}  // namespace
+
+void SetAchievementsUiHandler(AchievementsUiHandler handler) {
+  std::lock_guard lock(ListenerMutex());
+  UiHandlerStorage() = std::move(handler);
+}
+
+bool ShowAchievementsUi(uint32_t user_index) {
+  AchievementsUiHandler copy;
+  {
+    std::lock_guard lock(ListenerMutex());
+    copy = UiHandlerStorage();
+  }
+  return copy ? copy(user_index) : false;
+}
+
+}  // namespace rex::system::presence
